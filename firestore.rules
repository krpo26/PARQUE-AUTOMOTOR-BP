rules_version = '2';

// Reglas de seguridad de Cloud Firestore — PARQUE AUTOMOTOR BENJAMIN PAZ
//
// CÓMO APLICARLAS: consola de Firebase → Firestore Database → Reglas →
// pegar este archivo completo → Publicar. Pasos completos en SEGURIDAD.md.
//
// QUÉ HACEN:
//  1. Todo está bloqueado por defecto.
//  2. Cada colección exige sesión de Firebase (request.auth != null).
//  3. Cada escritura se valida: forma básica, tipos de los campos
//     clave y largo máximo de textos, para evitar basura o documentos
//     gigantes.
//  4. audit_log y deleted_records son solo de creación (no se editan
//     ni se borran).
//  5. common_users nunca puede tener rol "god".
//
// QUÉ NO HACEN (límite real, no de estas reglas): la app usa una
// sesión anónima compartida, así que estas reglas no pueden distinguir
// entre el admin, un usuario común y alguien que copió la configuración
// pública del APK. Lo que sí cierra el acceso es Firebase App Check
// (ver SEGURIDAD.md, paso 4) y, a largo plazo, Firebase Auth con una
// cuenta por persona.
//
// IMPORTANTE: estas reglas NO usan una lista cerrada de campos a
// propósito: si una versión futura de la app agrega un campo, la
// sincronización no se rompe en silencio. Si agregás una colección
// nueva, tenés que sumarla acá.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Funciones auxiliares ----
    function signedIn() {
      return request.auth != null;
    }
    function body() {
      return request.resource.data;
    }
    // Texto obligatorio, no vacío, de hasta `max` caracteres.
    function reqStr(k, max) {
      return body().get(k, null) is string
          && body().get(k, null).size() > 0
          && body().get(k, null).size() <= max;
    }
    // Texto opcional (puede faltar o ser null), de hasta `max` caracteres.
    function optStr(k, max) {
      return body().get(k, null) == null
          || (body().get(k, null) is string && body().get(k, null).size() <= max);
    }
    // Máximo de campos por documento.
    function maxKeys(n) {
      return body().size() <= n;
    }

    // Bloquea TODO por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Datos del parque automotor ----
    match /vehicles/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(40)
        && reqStr('id', 100) && optStr('plate', 40) && optStr('brand', 100)
        && optStr('model', 100) && optStr('notes', 5000)
        && optStr('photo_path', 1000) && optStr('complex_id', 100);
    }
    match /drivers/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(40)
        && reqStr('id', 100) && optStr('full_name', 200)
        && optStr('document_id', 60) && optStr('phone', 60)
        && optStr('address', 500) && optStr('complex_id', 100);
    }
    match /procedures/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(20)
        && reqStr('id', 100) && optStr('type', 100) && optStr('status', 100)
        && optStr('file_number', 100) && optStr('complex_id', 100)
        && optStr('vehicle_id', 100) && optStr('end_date', 40)
        && optStr('presented_at', 300) && optStr('photo_paths', 5000);
    }
    // Fotos de TODA la app (trámites, choferes, carnets, documentos de
    // vehículos, observaciones, mantenimiento, tickets). El id del
    // documento es el nombre del archivo (UUID aleatorio). Solo se
    // puede leer un documento puntual (get): NO se puede listar la
    // colección. La foto viaja en base64 (la app la limita a ~650 KB).
    match /shared_photos/{id} {
      allow get, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(6)
        && reqStr('id', 120) && body().id == id
        && optStr('owner_id', 100)
        && body().get('data_b64', null) is string
        && body().get('data_b64', '').size() <= 900000;
    }
    // Colección de una versión anterior (solo trámites): se sigue
    // pudiendo leer y borrar.
    match /procedure_photos/{id} {
      allow get, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(6)
        && reqStr('id', 120) && body().id == id
        && optStr('procedure_id', 100)
        && body().get('data_b64', null) is string
        && body().get('data_b64', '').size() <= 900000;
    }
    match /maintenance_records/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(20)
        && reqStr('id', 100) && optStr('vehicle_id', 100)
        && optStr('type', 100) && optStr('description', 5000);
    }
    match /vehicle_observation_photos/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(12)
        && reqStr('id', 100) && optStr('vehicle_id', 100)
        && optStr('photo_path', 1000);
    }
    match /maintenance_record_photos/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(12)
        && reqStr('id', 100) && optStr('record_id', 100)
        && optStr('photo_path', 1000);
    }
    match /fuel_logs/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(24)
        && reqStr('id', 100) && optStr('vehicle_id', 100)
        && optStr('station_name', 200) && optStr('driver_name', 200)
        && optStr('notes', 2000) && optStr('ticket_photo_path', 1000);
    }
    match /vehicle_tech_sheets/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(20)
        && reqStr('id', 100) && optStr('vehicle_id', 100)
        && optStr('driver_name', 200) && optStr('parts', 5000)
        && optStr('shop', 300);
    }

    // ---- Configuración y registros legales ----
    // El id del documento es la clave de la pestaña.
    match /feature_flags/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && maxKeys(6)
        && reqStr('key', 100) && body().key == id;
      allow delete: if signedIn();
    }
    // El id del documento es el nombre de usuario.
    match /legal_acceptances/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && maxKeys(6)
        && reqStr('username', 100) && body().username == id
        && optStr('version', 50);
      allow delete: if signedIn();
    }

    // ---- Apariencia de cada complejo (logo, tema, color, letra) ----
    // El id del documento es el id del complejo. El logo viaja en base64
    // (la app lo limita a unos 700 KB).
    match /complex_appearances/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && maxKeys(10)
        && reqStr('complex_id', 100) && body().complex_id == id
        && optStr('theme_mode', 20) && optStr('font_key', 60)
        && optStr('logo_b64', 900000);
      allow delete: if false;
    }

    // ---- Registros que no se pueden alterar ----
    match /audit_log/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && maxKeys(10)
        && reqStr('id', 100) && reqStr('action', 300)
        && optStr('username', 100) && optStr('entity_type', 100)
        && optStr('entity_label', 500);
      allow update, delete: if false;
    }
    match /deleted_records/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && maxKeys(6)
        && reqStr('type', 50) && reqStr('id', 100);
      allow update, delete: if false;
    }

    // ---- Usuarios comunes (para iniciar sesión desde cualquier equipo) ----
    // Solo guardan usuario y HASH de contraseña. El usuario god NUNCA
    // se sube: acá el rol solo puede ser "common".
    match /common_users/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && maxKeys(8)
        && reqStr('id', 100) && reqStr('username', 100)
        && reqStr('password_hash', 300)
        && body().get('role', null) == 'common'
        && optStr('allowed_complexes', 500);
    }
  }
}
