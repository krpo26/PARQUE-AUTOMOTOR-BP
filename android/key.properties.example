# Copiá este archivo como android/key.properties SOLO en tu máquina (NO lo subas a git).
# En Codemagic no hace falta: el paso "Preparar firma de release" lo genera solo con el
# grupo de variables seguras "keystore_credentials".
storePassword=LA_CONTRASEÑA_DE_LA_KEYSTORE
keyPassword=LA_CONTRASEÑA_DE_LA_CLAVE
keyAlias=fleetapp
storeFile=/ruta/absoluta/a/tu/fleetapp-release.jks
